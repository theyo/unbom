<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Title>unbom</Title>
        <Description>Removes UTF-8 BOM marker from text files</Description>
        <Authors>Sedat Kapanoglu</Authors>
        <Copyright>Copyright © Sedat Kapanoglu 2016-2020</Copyright>
        <Version>3.3.1</Version>

        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>unbom</ToolCommandName>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/ssg/unbom</RepositoryUrl>

        <Nullable>enable</Nullable>
        <DebugType>embedded</DebugType>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <PackageReleaseNotes>
            <![CDATA[
Add README entry to the package
]]>
        </PackageReleaseNotes>
        <LangVersion>11.0</LangVersion>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration)=='Release'">
        <WarningsAsErrors>true</WarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="stylecop.json" />
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="stylecop.json" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="System.CommandLine.NamingConventionBinder" Version="2.0.0-beta5.25306.1" />
    </ItemGroup>
    <ItemGroup>
        <None Update="README.md">
            <Pack>true</Pack>
            <PackagePath>/</PackagePath>
        </None>
    </ItemGroup>
</Project>